#include <winuser.h>

#define IDI_ICON1 101

IDI_ICON1 ICON "app.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "CompanyName", "sdo-edit-pic project"
            VALUE "FileDescription", "画像編集ソフト"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "sdo_edit_pic"
            VALUE "OriginalFilename", "sdo_edit_pic.exe"
            VALUE "ProductName", "sdo-edit-pic"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END
